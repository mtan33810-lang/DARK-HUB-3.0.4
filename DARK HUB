local autoWaterEnabled = false
local autoEquipCan = false

local selectedWaterCan = "Water Can"
local selectedWaterPlants = {}

local waterRadius = 100
local waterCooldown = 0.2

local WaterCans = {
    "Water Can",
    "Wonder Water",
    "Super Watering Can",
    "Sugar Watering Can"
}

local function getWaterRemote()
    return GameEvents:FindFirstChild("Water_RE")
end

local function isWaterCanEquipped()
    local Character = getCharacter()
    if not Character then
        return false
    end

    for _, Tool in ipairs(Character:GetChildren()) do
        if Tool:IsA("Tool") then
            if string.lower(Tool.Name) == string.lower(selectedWaterCan) or containsIgnoreCase(Tool.Name, "water") then
                return true
            end
        end
    end

    return false
end

local function equipWaterCan()
    local Character = getCharacter()
    local Humanoid = getHumanoid()

    if not Character or not Humanoid then
        return false
    end

    if isWaterCanEquipped() then
        return true
    end

    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    if not Backpack then
        return false
    end

    for _, Tool in ipairs(Backpack:GetChildren()) do
        if Tool:IsA("Tool") then
            if string.lower(Tool.Name) == string.lower(selectedWaterCan) then
                Humanoid:EquipTool(Tool)
                return true
            end
        end
    end

    for _, Tool in ipairs(Backpack:GetChildren()) do
        if Tool:IsA("Tool") then
            if containsIgnoreCase(Tool.Name, "water") then
                Humanoid:EquipTool(Tool)
                return true
            end
        end
    end

    return false
end

local function waterPlant(Plant)
    local Remote = getWaterRemote()

    if not Remote then
        return
    end

    local Position = getPlantPosition(Plant)

    if Position then
        Remote:FireServer(Position)
    end
end

local function getNearbyWaterPlants()
    local PlantsPhysical = getPlantsPhysical()
    local RootPart = getRootPart()

    if not PlantsPhysical or not RootPart then
        return {}
    end

    local Result = {}

    for _, Plant in ipairs(PlantsPhysical:GetChildren()) do
        local Position = getPlantPosition(Plant)

        if Position then
            local Distance = (RootPart.Position - Position).Magnitude

            if Distance <= waterRadius then
                local Name = getPlantName(Plant)

                local Allowed =
                    #selectedWaterPlants == 0
                    or selectionContains(selectedWaterPlants, Name)

                if Allowed then
                    table.insert(Result, {
                        Object = Plant,
                        Distance = Distance
                    })
                end
            end
        end
    end

    table.sort(Result, function(A, B)
        return A.Distance < B.Distance
    end)

    return Result
end

task.spawn(function()
    while true do
        task.wait(0.1)

        if autoWaterEnabled then
            if autoEquipCan then
                equipWaterCan()
            end

            if isWaterCanEquipped() then
                for _, Data in ipairs(getNearbyWaterPlants()) do
                    if not autoWaterEnabled or not isWaterCanEquipped() then
                        break
                    end

                    waterPlant(Data.Object)
                    task.wait(waterCooldown)
                end
            end
        end
    end
end)

local function filterList(sourceList, searchText)
    local filtered = {}
    local search = string.lower(searchText or "")

    if search == "" then
        return sourceList
    end

    for _, item in ipairs(sourceList) do
        if string.find(string.lower(item), search, 1, true) then
            table.insert(filtered, item)
        end
    end
    return filtered
end

