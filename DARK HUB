local function getPlantsPhysical()
    local Farm = Workspace:FindFirstChild("Farm")

    if not Farm then
        return nil
    end

    local NestedFarm = Farm:FindFirstChild("Farm")

    if NestedFarm then
        local Important = NestedFarm:FindFirstChild("Important")

        if Important then
            local Plants = Important:FindFirstChild("Plants_Physical")

            if Plants then
                return Plants
            end
        end
    end

    return Farm:FindFirstChild("Plants_Physical", true)
end

