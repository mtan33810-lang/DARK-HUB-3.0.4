local function getPlantsPhysical()
    local Farm = Workspace:FindFirstChild("Farm")

    if not Farm then
        return nil
    end

    local NestedFarm = Farm:FindFirstChild("Farm")

    if NestedFarm then
        local Important = NestedFarm:FindFirstChild("Important")

        if Important then
            local Plants = Important:FindFirstChild("Plants_Physical")

            if Plants then
                return Plants
            end
        end
    end

    return Farm:FindFirstChild("Plants_Physical", true)
end

--============================================================
-- SELECTION HELPERS
--============================================================

local function convertSelection(Value)
    if type(Value) == "table" then
        return Value
    end

    if Value ~= nil then
        return {Value}
    end

    return {}
end

local function containsIgnoreCase(text, search)
    if not text or not search then
        return false
    end

    return string.find(
        string.lower(tostring(text)),
        string.lower(tostring(search)),
        1,
        true
    ) ~= nil
end

local function selectionContains(list, value)
    for _, selected in ipairs(list) do
        if containsIgnoreCase(value, selected) then
            return true
        end
    end

    return false
end

--============================================================
-- PLANT & SEED MATCHING HELPERS
--============================================================

local function getPlantName(Plant)
    if not Plant then
        return ""
    end

    local AttributeName = Plant:GetAttribute("PlantName")

    if AttributeName then
        return tostring(AttributeName)
    end

    return Plant.Name
end

local function getPlantPosition(Plant)
    if not Plant then
        return nil
    end

    if Plant:IsA("BasePart") then
        return Plant.Position
    end

    if Plant:IsA("Model") then
        if Plant.PrimaryPart then
            return Plant.PrimaryPart.Position
        end

        local Part = Plant:FindFirstChildWhichIsA("BasePart", true)

        if Part then
            return Part.Position
        end
    end

    return nil
end

local function getUniquePlantNames()
    local Result = {}
    local Seen = {}

    local PlantsPhysical = getPlantsPhysical()

    if not PlantsPhysical then
        return ALL_PLANTS
    end

    for _, Plant in ipairs(PlantsPhysical:GetChildren()) do
        local Name = getPlantName(Plant)

        if Name ~= "" and not Seen[Name] then
            Seen[Name] = true
            table.insert(Result, Name)
        end
    end

    if #Result == 0 then
        return ALL_PLANTS
    end

    table.sort(Result)

    return Result
end

