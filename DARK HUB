            local Trowel = GetTrowel()
            if Trowel then
                for _, plant in ipairs(PlantsFolder:GetChildren()) do
                    if not AutoTrowelEnabled then break end
                    
                    if IsPlantAllowed(plant) then
                        local targetCFrame = CFrame.new(PlacementPos)
                        
                        pcall(function()
                            TrowelRemote:InvokeServer("Pickup", Trowel, plant)
                        end)
                        
                        task.wait(0.1)
                        
                        pcall(function()
                            TrowelRemote:InvokeServer("Place", Trowel, plant, targetCFrame)
                        end)
                        
                        task.wait(0.1)
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

