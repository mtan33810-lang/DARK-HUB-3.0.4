--============================================================
-- ESP RENDER LOOP
--============================================================

RunService.RenderStepped:Connect(function()
    local character = getCharacter()
    local localRoot = getRoot(character)

    for player, drawings in pairs(ESPCache) do
        if not Settings.ESPEnabled or not localRoot or not isValidPlayerTarget(player) then
            hideESP(drawings)
            continue
        end

        local targetCharacter = player.Character
        local root = targetCharacter:FindFirstChild("HumanoidRootPart")
        local humanoid = targetCharacter:FindFirstChildOfClass("Humanoid")

        if not root or not humanoid then
            hideESP(drawings)
            continue
        end

        local size = Vector3.new(2, 3, 2)
        local cf = root.CFrame

        local corners = {
            cf * CFrame.new(-size.X, size.Y, -size.Z),
            cf * CFrame.new(size.X, size.Y, -size.Z),
            cf * CFrame.new(size.X, size.Y, size.Z),
            cf * CFrame.new(-size.X, size.Y, size.Z),
            cf * CFrame.new(-size.X, -size.Y, -size.Z),
            cf * CFrame.new(size.X, -size.Y, -size.Z),
            cf * CFrame.new(size.X, -size.Y, size.Z),
            cf * CFrame.new(-size.X, -size.Y, size.Z)
        }

        local screenCorners = {}
        local minX, minY, maxY = math.huge, math.huge, -math.huge
        local allVisible = true

        for i, corner in ipairs(corners) do
            local position, visible = Camera:WorldToViewportPoint(corner.Position)
            if not visible then allVisible = false end

            screenCorners[i] = Vector2.new(position.X, position.Y)
            minX = math.min(minX, position.X)
            minY = math.min(minY, position.Y)
            maxY = math.max(maxY, position.Y)
        end

        local connections = {
            {1,2}, {2,3}, {3,4}, {4,1},
            {5,6}, {6,7}, {7,8}, {8,5},
            {1,5}, {2,6}, {3,7}, {4,8}
        }

        if Settings.ESPBoxes and allVisible then
            for i, connection in ipairs(connections) do
                local line = drawings.Lines[i]
                line.From = screenCorners[connection[1]]
                line.To = screenCorners[connection[2]]
                line.Color = Settings.BoxColor
                line.Thickness = Settings.BoxThickness
                line.Visible = true
            end
        else
            for _, line in ipairs(drawings.Lines) do
                line.Visible = false
            end
        end

        local screenPosition, visible = Camera:WorldToViewportPoint(root.Position)
        if not visible then
            hideESP(drawings)
            continue
        end

        if Settings.ESPTracers then
            local viewport = Camera.ViewportSize
            local origin = Vector2.new(viewport.X / 2, viewport.Y)

            if Settings.TracerOrigin == "Center" then
                origin = Vector2.new(viewport.X / 2, viewport.Y / 2)
            elseif Settings.TracerOrigin == "Top" then
                origin = Vector2.new(viewport.X / 2, 0)
            end

            drawings.Tracer.From = origin
            drawings.Tracer.To = Vector2.new(screenPosition.X, maxY)
            drawings.Tracer.Color = Settings.TracerColor
            drawings.Tracer.Thickness = Settings.TracerThickness
            drawings.Tracer.Visible = true
        else
            drawings.Tracer.Visible = false
        end

        local distance = (localRoot.Position - root.Position).Magnitude
        local text = player.Name

        if Settings.ESPDistance then
            text = text .. string.format(" [%d studs]", math.floor(distance))
        end

        drawings.NameTag.Text = text
        drawings.NameTag.Position = Vector2.new(screenPosition.X, minY - 16)
        drawings.NameTag.Visible = Settings.ESPNames or Settings.ESPDistance

        if Settings.ESPHealth then
            local boxHeight = math.max(math.abs(maxY - minY), 1)
            local maxHealth = math.max(humanoid.MaxHealth, 1)
            local healthPercent = math.clamp(humanoid.Health / maxHealth, 0, 1)

            local barWidth = 3
            local barHeight = boxHeight * healthPercent
            local healthColor = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)

            drawings.HealthOutline.Size = Vector2.new(barWidth + 2, boxHeight + 2)
            drawings.HealthOutline.Position = Vector2.new(minX - barWidth - 6, minY - 1)
            drawings.HealthOutline.Visible = true

            drawings.HealthBar.Size = Vector2.new(barWidth, barHeight)
            drawings.HealthBar.Position = Vector2.new(minX - barWidth - 5, minY + (boxHeight - barHeight))
            drawings.HealthBar.Color = healthColor
            drawings.HealthBar.Visible = true

            drawings.HealthText.Text = string.format("%d/%d HP", math.floor(humanoid.Health), math.floor(maxHealth))
            drawings.HealthText.Color = healthColor
            drawings.HealthText.Position = Vector2.new(minX - 60, minY)
            drawings.HealthText.Visible = true
        else
            drawings.HealthOutline.Visible = false
            drawings.HealthBar.Visible = false
            drawings.HealthText.Visible = false
        end
    end
end)

--============================================================
-- AIM LOOP
--============================================================

RunService.RenderStepped:Connect(function()
    if FOVCircle then
        FOVCircle.Visible = Settings.ShowFOV
        if Settings.ShowFOV then
            local viewport = Camera.ViewportSize
            FOVCircle.Position = Vector2.new(viewport.X / 2, viewport.Y / 2)
            FOVCircle.Radius = Settings.FOV
        end
    end

    if not Settings.Aimbot then return end

    local target
    if Settings.TargetLock and isValidPlayerTarget(Settings.AimTarget) then
        target = Settings.AimTarget
    else
        target = getAimTarget()
        Settings.AimTarget = target
    end

    if not target then return end

    local character = target.Character
    local targetPart = character:FindFirstChild(Settings.TargetPart) or character:FindFirstChild("HumanoidRootPart")

    if not targetPart then
        Settings.AimTarget = nil
        return
    end

    local desired = CFrame.lookAt(Camera.CFrame.Position, targetPart.Position)
    Camera.CFrame = Camera.CFrame:Lerp(desired, Settings.Smoothness)
end)

--============================================================
-- NPC BOT LOOP
--============================================================

RunService.Heartbeat:Connect(function(deltaTime)
    if not Settings.AutoPlayer or not CombatEvent then return end

    local character = getCharacter()
    local humanoid = getHumanoid(character)
    local root = getRoot(character)

    if not humanoid or not root then return end

    if not isValidEnemy(Settings.BotTarget) then
        Settings.BotTarget = getClosestEnemy()
    end

    local target = Settings.BotTarget
    if not target then return end

    local enemyRoot = target:FindFirstChild("HumanoidRootPart")
    local enemyHumanoid = target:FindFirstChildOfClass("Humanoid")

    if not enemyRoot or not enemyHumanoid or enemyHumanoid.Health <= 0 then
        Settings.BotTarget = nil
        return
    end

    local distance = (root.Position - enemyRoot.Position).Magnitude

    if distance > Settings.AttackRange then
        humanoid:MoveTo(enemyRoot.Position)
    else
        humanoid:MoveTo(root.Position)
        attackTimer += deltaTime

        if attackTimer >= 0.35 then
            attackTimer = 0
            CombatEvent:FireServer("Attack", target)
        end
    end
end)

