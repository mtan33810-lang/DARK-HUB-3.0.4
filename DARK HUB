--============================================================
-- SELECTION HELPERS
--============================================================

local function convertSelection(Value)
    if type(Value) == "table" then
        return Value
    end

    if Value ~= nil then
        return {Value}
    end

    return {}
end

local function containsIgnoreCase(text, search)
    if not text or not search then
        return false
    end

    return string.find(
        string.lower(tostring(text)),
        string.lower(tostring(search)),
        1,
        true
    ) ~= nil
end

local function selectionContains(list, value)
    for _, selected in ipairs(list) do
        if containsIgnoreCase(value, selected) then
            return true
        end
    end

    return false
end

--============================================================
-- AUTO WATER SYSTEM
--============================================================

local autoWaterEnabled = false
local autoEquipCan = false

local selectedWaterCan = "Water Can"
local selectedWaterPlants = {}

local waterRadius = 100
local waterCooldown = 0.2

local WaterCans = {
    "Water Can",
    "Wonder Water",
    "Super Watering Can",
    "Sugar Watering Can"
}

local function getWaterRemote()
    return GameEvents:FindFirstChild("Water_RE")
end

local function getPlantPosition(Plant)
    if not Plant then
        return nil
    end

    if Plant:IsA("BasePart") then
        return Plant.Position
    end

    if Plant:IsA("Model") then
        if Plant.PrimaryPart then
            return Plant.PrimaryPart.Position
        end

        local Part = Plant:FindFirstChildWhichIsA(
            "BasePart",
            true
        )

        if Part then
            return Part.Position
        end
    end

    return nil
end

local function getPlantName(Plant)
    if not Plant then
        return ""
    end

    local AttributeName = Plant:GetAttribute("PlantName")

    if AttributeName then
        return tostring(AttributeName)
    end

    return Plant.Name
end

local function getUniquePlantNames()
    local Result = {}
    local Seen = {}

    local PlantsPhysical = getPlantsPhysical()

    if not PlantsPhysical then
        return ALL_PLANTS
    end

    for _, Plant in ipairs(PlantsPhysical:GetChildren()) do
        local Name = getPlantName(Plant)

        if Name ~= "" and not Seen[Name] then
            Seen[Name] = true
            table.insert(Result, Name)
        end
    end

    if #Result == 0 then
        return ALL_PLANTS
    end

    table.sort(Result)

    return Result
end

local function equipWaterCan()
    local Character = getCharacter()
    local Humanoid = getHumanoid()

    if not Character or not Humanoid then
        return false
    end

    for _, Tool in ipairs(Character:GetChildren()) do
        if Tool:IsA("Tool") then
            if string.lower(Tool.Name) == string.lower(selectedWaterCan) then
                return true
            end
        end
    end

    local Backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

    if not Backpack then
        return false
    end

    for _, Tool in ipairs(Backpack:GetChildren()) do
        if Tool:IsA("Tool") then
            if string.lower(Tool.Name) == string.lower(selectedWaterCan) then
                Humanoid:EquipTool(Tool)
                return true
            end
        end
    end

    for _, Tool in ipairs(Backpack:GetChildren()) do
        if Tool:IsA("Tool") then
            if containsIgnoreCase(Tool.Name, "water") then
                Humanoid:EquipTool(Tool)
                return true
            end
        end
    end

    return false
end

local function waterPlant(Plant)
    local Remote = getWaterRemote()

    if not Remote then
        return
    end

    local Position = getPlantPosition(Plant)

    if Position then
        Remote:FireServer(Position)
    end
end

local function getNearbyWaterPlants()
    local PlantsPhysical = getPlantsPhysical()
    local RootPart = getRootPart()

    if not PlantsPhysical or not RootPart then
        return {}
    end

    local Result = {}

    for _, Plant in ipairs(PlantsPhysical:GetChildren()) do
        local Position = getPlantPosition(Plant)

        if Position then
            local Distance = (RootPart.Position - Position).Magnitude

            if Distance <= waterRadius then
                local Name = getPlantName(Plant)

                local Allowed =
                    #selectedWaterPlants == 0
                    or selectionContains(selectedWaterPlants, Name)

                if Allowed then
                    table.insert(Result, {
                        Object = Plant,
                        Distance = Distance
                    })
                end
            end
        end
    end

    table.sort(Result, function(A, B)
        return A.Distance < B.Distance
    end)

    return Result
end

task.spawn(function()
    while true do
        task.wait(0.1)

        if autoWaterEnabled then
            if autoEquipCan then
                equipWaterCan()
            end

            for _, Data in ipairs(getNearbyWaterPlants()) do
                if not autoWaterEnabled then
                    break
                end

                waterPlant(Data.Object)
                task.wait(waterCooldown)
            end
        end
    end
end)

--============================================================
-- AUTO COLLECT SYSTEM & LOGIC
--============================================================

local autoCollectEnabled = false
local autoCollectAll = false
local autoCollectSelectedPlants = false

local selectedCollectPlants = {}

local collectionRadius = 100
local collectCooldown = 0.1

local function matchesPlant(Plant)
    if not Plant then
        return false
    end

    if autoCollectAll then
        return true
    end

    if not autoCollectSelectedPlants then
        return false
    end

    local Name = getPlantName(Plant)

    return selectionContains(
        selectedCollectPlants,
        Name
    )
end

local function getNearbyCollectPlants()
    local PlantsPhysical = getPlantsPhysical()
    local RootPart = getRootPart()

    if not PlantsPhysical or not RootPart then
        return {}
    end

    local Result = {}
    local Seen = {}

    for _, Plant in ipairs(PlantsPhysical:GetChildren()) do
        if Plant:IsA("Model") or Plant:IsA("BasePart") then
            if not Seen[Plant] then
                Seen[Plant] = true

                if matchesPlant(Plant) then
                    local Position = getPlantPosition(Plant)

                    if Position then
                        local Distance =
                            (RootPart.Position - Position).Magnitude

                        if Distance <= collectionRadius then
                            table.insert(Result, {
                                Object = Plant,
                                Distance = Distance
                            })
                        end
                    end
                end
            end
        end
    end

    table.sort(Result, function(A, B)
        return A.Distance < B.Distance
    end)

    return Result
end

