    end,
})

ShopTab:CreateToggle({
    Name = "Auto Buy Eggs",
    CurrentValue = false,
    Flag = "AutoBuyEggsFlag",
    Callback = function(Value)
        autoBuyEggs = Value
    end,
})

task.spawn(function()
    while true do
        if autoBuyEggs and #selectedEggs > 0 then
            pcall(function()
                local eggRemote = ReplicatedStorage:FindFirstChild("GameEvents") and ReplicatedStorage.GameEvents:FindFirstChild("BuyPetEgg")
                if eggRemote then
                    for _, eggType in ipairs(selectedEggs) do
                        if not autoBuyEggs then break end
                        eggRemote:FireServer(eggType)
                    end
                end
            end)
        end
        task.wait(1)
    end
end)

