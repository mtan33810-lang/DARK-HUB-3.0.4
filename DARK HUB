AutomaticallyTab:CreateInput({
    Name = "Search Plant",
    PlaceholderText = "Type plant name...",
    RemoveTextAfterFocusLost = false,
    Flag = "PlantSearch",
    Callback = function(Text)
        local filtered = {}
        local search = string.lower(Text)

        if search == "" then
            filtered = ALL_PLANTS
        else
            for _, plant in ipairs(ALL_PLANTS) do
                if string.find(string.lower(plant), search, 1, true) then
                    table.insert(filtered, plant)
                end
            end
        end

        CollectPlantDropdown:Refresh(filtered)
    end
})

